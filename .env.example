# =============================================================================
# 个人知识库多智能体系统 — 环境变量配置示例
# 复制为 .env 并填入实际值
# =============================================================================

# ---- LLM 路由 ----
# ollama（默认本地）/ api（API key 模型）
LLM_PROVIDER=ollama

# Ollama 配置（LLM_PROVIDER=ollama 时生效）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_INGEST_MODEL=qwen2.5:7b
OLLAMA_CORRELATION_MODEL=qwen2.5:7b
OLLAMA_QA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# API 模型配置（LLM_PROVIDER=api 时生效）
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_INGEST_MODEL=gpt-4o-mini
# OPENAI_CORRELATION_MODEL=gpt-4o-mini
# OPENAI_QA_MODEL=gpt-4o-mini

# ---- Embedding 独立路由（可独立于 LLM provider）----
# local（默认，使用 BAAI/bge-m3 本地模型）/ ollama / api
EMBED_PROVIDER=local

# 本地 embedding 模型配置（EMBED_PROVIDER=local 时生效）
EMBED_MODEL_NAME=BAAI/bge-m3
# 下载源：modelscope（魔搭社区，国内推荐）/ huggingface
EMBED_MODEL_SOURCE=modelscope
# 本地缓存目录（相对于项目根）
EMBED_MODEL_CACHE_DIR=models/bge-m3
# 推理设备：cpu（默认，适配性优先，无需 GPU）/ cuda（需安装 CUDA 版 torch，如
# pip install torch==2.13.0+cu130 --index-url https://download.pytorch.org/whl/cu130）
EMBED_DEVICE=cpu

# ---- Obsidian Vault ----
# 留空则自动发现（需安装 Obsidian 桌面端）；手动指定示例：D:/Obsidian/User Data Library
# VAULT_ROOT=
# VAULT_AUTODISCOVER=true
VAULT_INBOX_DIR=Inbox

# ---- RAG / 向量库 ----
CHROMA_PERSIST_DIR=.chroma_db
RAG_COLLECTION_NAME=kb_notes
RAG_TOP_K=6

# ---- 视频转文档 ----
VIDEO_TO_TEXT_MCP_ENABLED=false

# ---- Obsidian CLI ----
OBSIDIAN_SKILL_ENABLED=false

# ---- 日志 ----
LOG_LEVEL=INFO
