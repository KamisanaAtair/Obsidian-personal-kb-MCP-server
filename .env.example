# host-delegated：生成工作由 Host 执行，无服务端生成式模型或 API key 配置。
# 复制为 .env；将 VAULT_ROOT 改为实际的 Obsidian Vault 绝对路径。
VAULT_ROOT=/absolute/path/to/your/vault
VAULT_AUTODISCOVER=false
VAULT_INBOX_DIR=Inbox

# prepare/finalize 必须在同一个服务进程内完成；重启清空会话。
INGEST_SESSION_TTL_MINUTES=60

# 本地 Embedding（不随生成工作外移）
EMBED_PROVIDER=local
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_MODEL_SOURCE=modelscope
EMBED_MODEL_CACHE_DIR=models/bge-m3
EMBED_DEVICE=cpu

CHROMA_PERSIST_DIR=.chroma_db
RAG_COLLECTION_NAME=kb_notes
RAG_TOP_K=6
CORRELATION_TOP_K=5
HYBRID_SEARCH_ENABLED=true

# false 使用带 STUB 标记的示例转写；真实转写须设 true，并安装 ffmpeg。
VIDEO_TO_TEXT_MCP_ENABLED=false
WHISPER_MODEL=medium
WHISPER_LANGUAGE=zh
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# false 通过文件系统创建草稿；true 尝试已有的 Obsidian CLI。
OBSIDIAN_SKILL_ENABLED=false
LOG_LEVEL=INFO
