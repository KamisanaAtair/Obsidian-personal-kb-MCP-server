# ============================================================
# 个人知识库多智能体系统 — 环境变量配置（占位符）
# 复制本文件为 .env 后填入真实值；.env 已加入 .gitignore 不会被提交
# ============================================================

# ---- 1. LLM 配置 ----
# 模型路由：各 Agent 可用不同模型，详见 config/settings.py
# 本期默认走本地 Ollama（无需 API key），API key 模型留作占位符，待定档后填入

# 1.1 Ollama（本地，默认）
# 仅需确保 ollama 服务已启动并已 pull 对应模型
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_INGEST_MODEL=PLACEHOLDER_OLLAMA_MODEL
OLLAMA_CORRELATION_MODEL=PLACEHOLDER_OLLAMA_MODEL
OLLAMA_QA_MODEL=PLACEHOLDER_OLLAMA_MODEL
OLLAMA_EMBED_MODEL=PLACEHOLDER_EMBED_MODEL

# 1.2 API key 模型（占位符，后续替换为真实 key）
# 当前留空：启用时在 config/settings.py 中将 LLM_PROVIDER 切换为 api
LLM_PROVIDER=ollama
OPENAI_API_KEY=PLACEHOLDER_OPENAI_API_KEY
OPENAI_BASE_URL=PLACEHOLDER_OPENAI_BASE_URL
OPENAI_INGEST_MODEL=PLACEHOLDER_OPENAI_MODEL
OPENAI_CORRELATION_MODEL=PLACEHOLDER_OPENAI_MODEL
OPENAI_QA_MODEL=PLACEHOLDER_OPENAI_MODEL

# ---- 2. Obsidian Vault 配置 ----
# Vault 路径发现（遵循 obsidian skill：不硬编码 vault 路径）：
#   VAULT_AUTODISCOVER=true（默认）→ 优先 obsidian-cli print-default / obsidian.json(open:true) 动态解析
#   动态解析失败时 fallback 到下面的 VAULT_ROOT
#   装了 Obsidian 桌面端即可自动发现，换机器/vault 名无需改这里
VAULT_AUTODISCOVER=true
# VAULT_ROOT 仅作 fallback（动态解析失败或 VAULT_AUTODISCOVER=false 时使用）。留空则依赖动态解析
# VAULT_ROOT=D:/Obsidian/User Data Library

# Inbox 目录：staged 草稿笔记落地位置，便于人工直观找到待审队列
VAULT_INBOX_DIR=Inbox

# status 字段名（frontmatter），取值 staged / promoted
NOTE_STATUS_FIELD=status

# ---- 3. RAG / 向量库配置（本地 Chroma）----
CHROMA_PERSIST_DIR=.chroma_db
# 检索时只召回 status=promoted 的笔记，靠 metadata 过滤保证
RAG_COLLECTION_NAME=kb_notes
RAG_TOP_K=6

# Correlation Agent 建议数量与相关性阈值（初始值，跑真实数据后调整，见需求第11节）
CORRELATION_TOP_K=5
CORRELATION_MIN_SCORE=0.35

# ---- 4. 视频转文档（独立实现：yt-dlp + whisper 三级 fallback）----
# 参考 bilibili-render-pdf skill 方法论：CC 字幕优先 → Whisper 转写 fallback
# ENABLED=false 时走 stub（无依赖环境调试用）
# 依赖：yt-dlp（必装）、ffmpeg（Whisper 路径需要，CC 字幕路径不需要）、
#       faster-whisper 或 openai-whisper（Whisper 路径需要）
VIDEO_TO_TEXT_MCP_ENABLED=false

# Whisper 转写配置
WHISPER_BACKEND=faster-whisper       # faster-whisper(轻量,默认) | openai-whisper(精度高,依赖torch)
WHISPER_MODEL=medium                # tiny|base|small|medium|large-v3
WHISPER_LANGUAGE=zh                  # 转写语言
WHISPER_DEVICE=cpu                   # cpu | cuda
WHISPER_COMPUTE_TYPE=int8           # int8(cpu) | float16(gpu) | float32

# ---- 5. Obsidian 整理（CLI 适配层）----
# 本系统不依赖 Host skill；在 core/tools/obsidian_cli.py 封装两类 CLI：
#   - 官方 obs（需 Obsidian 1.12+ 运行，自动更新双链）— 优先
#   - yakitrak obsidian-cli — 备选
#     · create/move/open 走 obsidian:// URI，仍需 Obsidian 桌面端安装（与 obs 同依赖）
#     · print-default/search/list 不依赖 Obsidian 运行（只读文件系统/obsidian.json）
#   都不可用或无 Obsidian 桌面端时 fallback 文件系统直接读写（真正的环境兜底）
# ENABLED=true 时尝试用 CLI 落地笔记（自动更新双链等）
OBSIDIAN_SKILL_ENABLED=false

# ---- 6. 日志 ----
LOG_LEVEL=INFO
